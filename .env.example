# Copy to .env.local and fill in. See README.md ("Supabase"). Never commit real values.
SUPABASE_URL=
# Recommended (server only): the service role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative when no service role key is set: the publishable / anon key.
SUPABASE_PUBLISHABLE_KEY=
# Signs the sign-in cookie. Use a long random string.
JWT_SECRET=
